# AUTH · copiar a .env y completar. NO versionar .env.
# En docker compose, DB_HOST/DB_PORT/DB_USER/DB_NAME/DB_PASSWORD se inyectan desde el .env raíz.
NODE_ENV=production
PORT=3000

# Solo para ejecutar fuera de Docker (npm run start:dev)
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth
DB_NAME=auth
DB_PASSWORD=

# Claves RS256 (./scripts/gen-keys.sh). En Docker se montan en solo lectura en /run/keys.
JWT_PRIVATE_KEY_PATH=/run/keys/private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=secure-chat
# Máximo 900 (15 min)
JWT_TTL_SECONDS=900

# Secreto compartido con STEGO (cabecera X-Service-Token). Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
SERVICE_TOKEN=

# Administrador inicial (lo crea el seed)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Mínimo 12 caracteres
ADMIN_PASSWORD=
