# STEGO · copiar a .env y completar. NO versionar .env.
# Directorio de datos (SQLite + cuarentena). En Docker es el volumen stego_data.
DATA_DIR=/data

# Verificación local del JWT: SOLO la clave pública (montada :ro). La privada vive en AUTH.
JWT_PUBLIC_KEY_PATH=/run/keys/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=secure-chat

# Decisión de autorización en AUTH (red interna de Docker)
AUTH_URL=http://auth:3000
AUTH_TIMEOUT_SECONDS=3
# El MISMO valor que SERVICE_TOKEN de auth-service/.env. Mínimo 32 caracteres.
SERVICE_TOKEN=

# Límites de entrada
MAX_UPLOAD_BYTES=5242880
MAX_PIXELS=16000000

# Detector chi-cuadrado (docs/05 §5.3)
SUSPICIOUS_THRESHOLD=0.95
INCONCLUSIVE_THRESHOLD=0.5
MIN_DIMENSION=64

LOG_LEVEL=INFO
